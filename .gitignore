node_modules
dist

# Environment Files
.env*

# Debug log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated protobuf files
server/generated/
client/pb/*.pb.go
client/pb/*_grpc.pb.go

# Editor-specific files
.vscode/
.idea/

# OS-specific files
.DS_Store
Thumbs.db
.vagrant/

# JavaScript compiled files
*.js

# TypeScript cache files
*.tsbuildinfo

# Lock files
yarn.lock

# Optional: PID files from daemon
*.pid

# Generated by Puppeteer
.screenshots/

# Don't check in any PNG files as I am currently using those for debugging.
*.PNG
*.png

# Compiled binaries
client/termium
client/client
client/hi


# Profiling data
*.prof

# Debug/timing output
client/timings
client/log

# Vendored extension runtime and its assets are release inputs.
!third_party/vimium/**/*.js
!third_party/vimium/**/*.png
